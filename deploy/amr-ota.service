# systemd unit for the AMR OTA server (ota_server/).
# Installed by deploy/install-services.sh; see deploy/README.md.
#   journalctl -u amr-ota -f
[Unit]
Description=AMR OTA server (registration, firmware updates, dashboard on 7000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amr
Group=amr
WorkingDirectory=/opt/client/ota_server
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
