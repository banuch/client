{
  "name": "amr-dlms-server",
  "version": "1.0.0",
  "description": "Receives meter readings and serial logs from the AMR ESP32 firmware over TCP; SQLite storage, REST API and a small web page",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "send-sample": "node tools/send-sample.js",
    "check": "node tools/check-receive.js"
  },
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.3"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
