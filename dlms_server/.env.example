# Copy to .env and fill in. Real environment variables win over this file.

# Device port: the firmware's DATA_SERVER_PORT (config.h). Open it in the firewall.
TCP_HOST=0.0.0.0
TCP_PORT=7001

# Web page + REST API. Without VIEW_PASSWORD the page has no login and is only
# reachable from this machine (127.0.0.1).
HTTP_HOST=0.0.0.0
HTTP_PORT=7002
VIEW_USER=admin
VIEW_PASSWORD=

# The OTA server's MASTER_SECRET (ota_server/.env). Used to check
# the device signatures. Empty = signatures are not checked, data is "unverified".
MASTER_SECRET=
# true = reject unsigned data (devices must be approved on the OTA dashboard first)
REQUIRE_SIGNED=false

# Optional
# DATA_DIR=./data
# TIMEZONE=Asia/Kolkata
# RETENTION_DAYS=0
# MAX_READING_BYTES=262144
# MAX_LOG_BYTES=1048576
# MAX_CONNECTIONS=200
# IDLE_TIMEOUT_SEC=120
# LOGIN_MAX_FAILS=10
# LOGIN_LOCK_SEC=900
